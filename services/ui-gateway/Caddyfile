# Basic-auth gateway in front of the Temporal Web UI.
# The UI itself has no username/password login (only OIDC), so this service is
# the only public entry point; the UI service stays on the private network.
{
	admin off
	auto_https off
	servers {
		# Railway's edge terminates TLS and forwards X-Forwarded-* headers.
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	# Unauthenticated liveness endpoint for the Railway healthcheck.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USERNAME} {$BASIC_AUTH_HASH}
		}
		reverse_proxy {$UPSTREAM_URL}
	}

	log {
		output stdout
		format console
	}
}
