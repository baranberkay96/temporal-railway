{
  "name": "Temporal v1 Durable Workflows Server",
  "description": "Reliable, retryable workflows in any language. Temporal server plus Web UI.",
  "category": "Queues",
  "tags": [
    "temporal",
    "workflows",
    "durable-execution",
    "orchestration",
    "microservices",
    "grpc"
  ],
  "services": {
    "temporal": {
      "icon": "https://temporal.io/favicon.svg",
      "source": {
        "repo": "baranberkay96/temporal-railway",
        "rootDirectory": "/services/temporal"
      },
      "preDeployCommand": [
        "/etc/temporal/railway/setup-schema.sh"
      ],
      "startCommand": null,
      "healthcheckPath": "/api/v1/system-info",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "7243",
          "description": "Frontend HTTP API port; Railway probes /api/v1/system-info on it.",
          "required": false
        },
        "DB": {
          "defaultValue": "postgres12",
          "description": "Persistence plugin (PostgreSQL 12+ SQL plugin, as in upstream compose).",
          "required": true
        },
        "DB_PORT": {
          "defaultValue": "5432",
          "description": "PostgreSQL port.",
          "required": false
        },
        "POSTGRES_SEEDS": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "PostgreSQL host (private network).",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "${{Postgres.PGUSER}}",
          "description": "PostgreSQL user (needs CREATE DATABASE on first deploy).",
          "required": true
        },
        "POSTGRES_PWD": {
          "defaultValue": "${{Postgres.PGPASSWORD}}",
          "description": "PostgreSQL password.",
          "required": true
        },
        "DBNAME": {
          "defaultValue": "temporal",
          "description": "Persistence database.",
          "required": false
        },
        "VISIBILITY_DBNAME": {
          "defaultValue": "temporal_visibility",
          "description": "Visibility database (SQL advanced visibility on PostgreSQL).",
          "required": false
        },
        "NUM_HISTORY_SHARDS": {
          "defaultValue": "512",
          "description": "History shards. FIXED at first start; cannot be changed later. 512 = Temporal's small-production guidance.",
          "required": false
        },
        "BIND_ON_IP": {
          "defaultValue": "::0",
          "description": "Listen on all IPv4+IPv6 interfaces (private network + optional TCP proxy).",
          "required": false
        },
        "TEMPORAL_BROADCAST_ADDRESS": {
          "defaultValue": "127.0.0.1",
          "description": "Membership/cluster address for this single-node (all roles) server.",
          "required": false
        },
        "LOG_LEVEL": {
          "defaultValue": "info",
          "description": "Server log level.",
          "required": false
        },
        "TEMPORAL_ADDRESS": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}:7233",
          "description": "gRPC address other Railway services use (copy into your workers).",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Graceful shutdown window.",
          "required": false
        }
      }
    },
    "temporal-namespace": {
      "icon": "https://temporal.io/favicon.svg",
      "source": {
        "image": "temporalio/admin-tools:1.32.1"
      },
      "startCommand": "/bin/sh -c 'i=0; until temporal operator cluster health --address \"$TEMPORAL_ADDRESS\"; do i=$((i+1)); [ \"$i\" -ge 90 ] && echo \"Temporal frontend not healthy\" && exit 1; echo \"waiting for Temporal frontend ($i)\"; sleep 10; done; if temporal operator namespace describe -n \"$DEFAULT_NAMESPACE\" --address \"$TEMPORAL_ADDRESS\" >/dev/null 2>&1; then echo \"namespace $DEFAULT_NAMESPACE already exists\"; else temporal operator namespace create -n \"$DEFAULT_NAMESPACE\" --retention \"$DEFAULT_NAMESPACE_RETENTION\" --address \"$TEMPORAL_ADDRESS\"; fi'",
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "numReplicas": 1,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "TEMPORAL_ADDRESS": {
          "defaultValue": "${{temporal.TEMPORAL_ADDRESS}}",
          "description": "Temporal frontend (private network).",
          "required": true
        },
        "DEFAULT_NAMESPACE": {
          "defaultValue": "default",
          "description": "Namespace created on first deploy.",
          "required": false
        },
        "DEFAULT_NAMESPACE_RETENTION": {
          "defaultValue": "7d",
          "description": "Retention of closed workflow histories in that namespace.",
          "required": false
        }
      }
    },
    "temporal-ui": {
      "icon": "https://temporal.io/favicon.svg",
      "source": {
        "image": "temporalio/ui:2.55.0"
      },
      "startCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "UI port (private only; exposed through temporal-ui-gateway).",
          "required": false
        },
        "TEMPORAL_UI_PORT": {
          "defaultValue": "8080",
          "description": "Port the UI server listens on.",
          "required": false
        },
        "TEMPORAL_ADDRESS": {
          "defaultValue": "${{temporal.TEMPORAL_ADDRESS}}",
          "description": "Temporal frontend (private network).",
          "required": true
        },
        "TEMPORAL_DEFAULT_NAMESPACE": {
          "defaultValue": "default",
          "description": "Namespace opened by default.",
          "required": false
        },
        "TEMPORAL_CORS_ORIGINS": {
          "defaultValue": "https://${{temporal-ui-gateway.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public origin of the UI (gateway domain).",
          "required": false
        },
        "TEMPORAL_AUTH_ENABLED": {
          "defaultValue": "false",
          "description": "Set true and fill TEMPORAL_AUTH_* to add OIDC login on top of basic auth.",
          "required": false
        }
      }
    },
    "temporal-ui-gateway": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/caddy.svg",
      "source": {
        "repo": "baranberkay96/temporal-railway",
        "rootDirectory": "/services/ui-gateway"
      },
      "startCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Gateway port.",
          "required": false
        },
        "BASIC_AUTH_USERNAME": {
          "defaultValue": "admin",
          "description": "Login for the Temporal Web UI.",
          "required": true
        },
        "BASIC_AUTH_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password for the Temporal Web UI (generated; hashed with bcrypt at start).",
          "required": true
        },
        "UPSTREAM_URL": {
          "defaultValue": "http://${{temporal-ui.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "Private address of the UI service.",
          "required": true
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": true
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": true
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": true
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": true
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres database.",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": true
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": true
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": true
        }
      }
    }
  },
  "buckets": []
}
